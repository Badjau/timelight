uint32_t textHash(const char* value) { uint32_t hash = 2166136261UL; while (*value) { hash ^= (uint8_t)*value++; hash *= 16777619UL; } return hash ? hash : 1; }
bool sessionMatches(Span object) { char session[41]; return readText(object, "sessionId", session, sizeof(session)) && browserSessionHash && textHash(session) == browserSessionHash; }

uint16_t checksum(const StoredPreset& value) { const uint8_t* bytes = (const uint8_t*)&value; uint16_t result = 0xFFFF; for (size_t i = 0; i < offsetof(StoredPreset, checksum); i++) { result ^= bytes[i]; for (uint8_t bit = 0; bit < 8; bit++) result = result & 1 ? result >> 1 ^ 0xA001 : result >> 1; } return result; }
