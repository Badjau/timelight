void printJsonString(const char* value) { Serial.print('"'); while (*value) { if (*value == '"' || *value == '\\') Serial.print('\\'); Serial.print(*value++); } Serial.print('"'); }
void sendError(const char* message, const char* id = 0) { Serial.print(F("{\"version\":3,\"type\":\"error\"")); if (id && id[0]) { Serial.print(F(",\"requestId\":")); printJsonString(id); } Serial.print(F(",\"message\":")); printJsonString(message); Serial.println('}'); }
void sendAck(const char* id) { Serial.print(F("{\"version\":3,\"type\":\"ack\",\"requestId\":")); printJsonString(id); Serial.print(F(",\"appliedRevision\":")); Serial.print(appliedRevision); Serial.println('}'); }
void sendReady(const char* id = 0) { Serial.print(F("{\"version\":3,\"type\":\"ready\"")); if (id && id[0]) { Serial.print(F(",\"requestId\":")); printJsonString(id); } Serial.print(F(",\"device\":\"timelight-arduino\",\"firmware\":\"0.4.0\",\"ledCount\":")); Serial.print(LED_COUNT); Serial.println(F(",\"buttons\":[\"play_pause\",\"next_stage\",\"reset\"],\"capabilities\":[\"standalone-preset\"]}")); }
void sendButton(const char* name) { Serial.print(F("{\"version\":3,\"type\":\"button\",\"button\":")); printJsonString(name); Serial.print(F(",\"sequence\":")); Serial.print(++buttonSequence); Serial.println('}'); }

