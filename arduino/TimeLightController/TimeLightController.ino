struct Span { const char* begin; const char* end; };

void skipWhitespace(const char*& p, const char* end) { while (p < end && (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')) p++; }
bool sameText(const char* p, size_t length, const char* expected) { return length == strlen(expected) && !strncmp(p, expected, length); }
bool valueSpan(Span input, Span& output) {
