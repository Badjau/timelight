void compiledDefault() { memset(&preset, 0, sizeof(preset)); preset.magic = PRESET_MAGIC; preset.schema = PRESET_SCHEMA; preset.stageCount = 4; preset.duration = 240; uint32_t times[] = {0,60,120,180}, colors[] = {0x0000FF,0xFFFF00,0xFF7B00,0xFF0000}; for (uint8_t i = 0; i < 4; i++) { preset.stages[i].threshold = times[i]; preset.stages[i].color = colors[i]; preset.stages[i].flags = i == 0 ? BUZZER_NONE : i == 3 ? BUZZER_REPEAT : BUZZER_ONCE; } preset.checksum = checksum(preset); }
