bool findKey(Span object, const char* key, Span& value) { const char* p = object.begin; while (p < object.end) { if (*p++ != '"') continue; const char* start = p; bool escaped = false; while (p < object.end) { if (escaped) escaped = false; else if (*p == '\\') escaped = true; else if (*p == '"') break; p++; } if (p >= object.end) return false; const char* after = p + 1; skipWhitespace(after, object.end); if (after < object.end && *after == ':' && sameText(start, p - start, key)) return valueSpan({ after + 1, object.end }, value); p++; } return false; }
